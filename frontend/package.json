{
  "name": "libracore-web",
  "private": true,
  "version": "1.2.0",
  "description": "LibraCore responsive library management web application with release-integrity validation",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanskarIN/libracore.git"
  },
  "bugs": {
    "url": "https://github.com/sanskarIN/libracore/issues"
  },
  "type": "module",
  "engines": {"node": "^22.12.0 || ^24.0.0 || >=26.0.0"},
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {"react": "19.2.8", "react-dom": "19.2.8"},
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.81.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
