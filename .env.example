# PostgreSQL
POSTGRES_DB=libracore
POSTGRES_USER=libracore
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend
DB_URL=jdbc:postgresql://localhost:5432/libracore
DB_USERNAME=libracore
DB_PASSWORD=change-me
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_SESSION_TTL_HOURS=12

# Optional first-run administrator bootstrap.
# Set these only in a private local environment; never commit a real password.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-locally

# Notifications. MOCK is the safe development default.
APP_NOTIFICATION_MODE=MOCK
APP_NOTIFICATION_FROM=no-reply@example.invalid
APP_NOTIFICATION_DISPATCH_INTERVAL_MS=5000
APP_RESERVATION_EXPIRY_SCAN_MS=60000

# SMTP is used only when APP_NOTIFICATION_MODE=EMAIL.
# Keep the actuator SMTP connectivity probe disabled for MOCK/local mode. Enable
# it in an EMAIL deployment only when mail availability should affect /health.
APP_MAIL_HEALTH_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
